NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=appads
DB_PASSWORD=appads
DB_NAME=appads
# Прогонять миграции автоматически при старте приложения
APP_ADS_AUTO_MIGRATE=true

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# S3 (Zenko CloudServer локально / S3-совместимое хранилище в проде)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=accessKey1
S3_SECRET_KEY=verySecretKey1
S3_BUCKET_RAW=app-ads-raw
S3_FORCE_PATH_STYLE=true

# ─── Сетевой слой / прокси ────────────────────────────────────────────────
# Пусто = прямой egress. Заполнить для единого ротирующего прокси-эндпоинта.
# Поддержка HTTP/HTTPS через undici EnvHttpProxyAgent (учитывает NO_PROXY).
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
APP_ADS_USER_AGENT=app-ads-worker/0.1
APP_ADS_HTTP_DEADLINE_MS=20000
APP_ADS_HTTP_HEADERS_TIMEOUT_MS=10000
APP_ADS_HTTP_BODY_TIMEOUT_MS=20000
APP_ADS_HTTP_CONNECT_TIMEOUT_MS=10000
APP_ADS_MAX_BYTES=10485760
APP_ADS_MAX_REDIRECTS=2
APP_ADS_HTTP_CONNECTIONS=64
APP_ADS_PER_HOST_RPS=2

# ─── Параллелизм ─────────────────────────────────────────────────────────
APP_ADS_QUEUE_CONCURRENCY=10
APP_ADS_HTTP_CONCURRENCY=20
APP_ADS_DB_WRITE_CONCURRENCY=6

# ─── Политика перескрапа (SLA свежести - сутки) ──────────────────────────
APP_ADS_REFRESH_INTERVAL_HOURS=24
APP_ADS_STRETCH_AFTER=5
APP_ADS_MAX_INTERVAL_HOURS=72
APP_ADS_NO_FILE_DAYS=10
APP_ADS_FAIL_THRESHOLD=10

# ─── Временный dev-продюсер ─────────
APP_ADS_ENABLE_DEV_SCHEDULER=true
APP_ADS_DEV_SCHEDULER_INTERVAL_MS=120000
APP_ADS_DEV_SCHEDULER_BUDGET=500
APP_ADS_BATCH_SIZE=25
# Засеять таблицу domain небольшим набором реальных доменов при старте
APP_ADS_DEV_SEED=false

# ─── Обслуживание партиций ──────────────────────────────────────────────
APP_ADS_PARTITION_MAINTENANCE=false
APP_ADS_PARTITION_RETENTION_MONTHS=6
